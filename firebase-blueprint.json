{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "technician"] },
        "name": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Client": {
      "title": "Client",
      "description": "PPPoE or Hotspot client",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["hotspot", "pppoe"] },
        "planName": { "type": "string" },
        "price": { "type": "number" },
        "startDate": { "type": "string", "format": "date-time" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "expired"] },
        "online": { "type": "boolean" },
        "phoneNumber": { "type": "string" },
        "macAddress": { "type": "string" },
        "routerId": { "type": "string" },
        "pppoeUsername": { "type": "string" },
        "pppoePassword": { "type": "string" }
      },
      "required": ["name", "type", "status"]
    },
    "Router": {
      "title": "Router",
      "description": "Network router configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "ipAddress": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "offline"] }
      },
      "required": ["name"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Payment and recharge history",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "planName": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["clientId", "amount", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Client management"
    },
    "/routers/{routerId}": {
      "schema": "Router",
      "description": "Router management"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Billing history"
    }
  }
}
